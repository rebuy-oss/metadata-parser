parameters:
    level: 1
    paths:
        - tests/
    excludePaths:
        # Excluded until the minimum version required from jms/serializer is set to >= 3.31.0
        - tests/ModelParser/Model/ClassUsingUnionDiscriminator.php
        - tests/ModelParser/Model/ClassUsingUnionTyping.php
        # looks like phpstan php parser has not implemented union types yet
        - tests/ModelParser/Fixtures/IntersectionTypeDeclarationModel.php
    ignoreErrors:
        # The second parameter or this class was only added in version 3.x from the doctrine/orm dependency, so we have
        # to ignore the error in case 2.x is installed.
        -
            message: '#Class Doctrine\\ORM\\Mapping\\Driver\\AttributeDriver constructor invoked with 2 parameters, 1 required.#'
            path: tests/ModelParser/DoctrineMetadataParserTest.php
            reportUnmatched: false
