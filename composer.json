{
    "name": "rebuy/metadata-parser",
    "description": "Parser for metadata",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Liip AG",
            "homepage": "http://www.liip.ch",
            "role": "Original Development (discontinued)"
        },
        {
            "name": "rebuy recommerce GmbH",
            "homepage": "https://www.rebuy.com",
            "role": "Maintainer"
        }
    ],
    "support": {
        "source": "https://github.com/rebuy-oss/metadata-parser",
        "issues": "https://github.com/rebuy-oss/metadata-parser/issues"
    },
    "require": {
        "php": "^8.4.1",
        "ext-json": "*",
        "phpstan/phpdoc-parser": "^1.30|^2.0",
        "psr/log": "^1|^2|^3",
        "symfony/type-info": "^7.2|^8.0"
    },
    "require-dev": {
        "doctrine/annotations": "^2.0.2",
        "doctrine/collections": "^1.6|^2.6.0|^3.1.0",
        "friendsofphp/php-cs-fixer": "^v3.94.2",
        "jms/serializer": "^3",
        "phpstan/phpstan": "^2.1.44",
        "phpstan/phpstan-phpunit": "^2.0.16",
        "phpunit/phpunit": "^13.1.10"
    },
    "suggest": {
        "jms/serializer": "If you want to parse JMS models into metadata",
        "doctrine/annotations": "In case you still need support for annotation based parsing of your JMS models"
    },
    "conflict": {
        "doctrine/annotations": "< 1.11"
    },
    "autoload": {
        "psr-4": {
            "Liip\\MetadataParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Liip\\MetadataParser\\": "tests/"
        }
    },
    "replace": {
        "liip/metadata-parser": "*"
    },
    "scripts": {
        "fix-cs": "vendor/bin/php-cs-fixer fix -v",
        "cs-fixer": "vendor/bin/php-cs-fixer fix --dry-run --diff -v",
        "phpstan": "vendor/bin/phpstan analyse",
        "phpstan-tests": "vendor/bin/phpstan analyse -c phpstan.tests.neon",
        "phpstan-all": [
            "@phpstan",
            "@phpstan-tests"
        ],
        "phpunit": "vendor/bin/phpunit",
        "ci": [
            "@cs-fixer",
            "@phpstan-all",
            "@phpunit"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
