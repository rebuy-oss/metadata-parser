parameters:
    level: 6
    dynamicConstantNames:
        - PHP_VERSION_ID
    paths:
        - src/
    ignoreErrors:
        # Both errors happen when doctrine/orm 3.x is installed.
        # Since there is a proper condition that handles this case, we can ignore these errors
        -
            message: '#Class Doctrine\\ORM\\Mapping\\ClassMetadataInfo not found#'
            path: src/ModelParser/DoctrineMetadataParser.php
            reportUnmatched: false
        -
            message: '#unknown class Doctrine\\ORM\\Mapping\\ClassMetadataInfo#'
            path: src/ModelParser/DoctrineMetadataParser.php
            reportUnmatched: false

        # These error occur when phpstan is installed in a newer version.
        # There is a proper `class_exists` in place to handle this case, so we can ignore them.
        -
            message: '#constructor (invoked with|expects)#'
            path: src/TypeResolver/LiipStringTypeResolver.php
            reportUnmatched: false
